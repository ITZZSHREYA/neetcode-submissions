class Solution {
    public int maxSubarraySum(int[] arr, int k)
    {
        int sum=0,low=0,high=k-1;
        int n=arr.length;
        int res=0;
        for(int i=0;i<k;i++)
        {
            sum+=arr[i];
        }
        res=sum;
        while(high<n-1)
        {
            
            
            if(high==n)
            {
                break;
            }
            low++;
            high++;
            
            sum=sum-arr[low-1];
            sum=sum+arr[high];
            res = Math.max(res, sum);
            
            
        }
        return res;
        
        // Code here
        
    }
    
}
