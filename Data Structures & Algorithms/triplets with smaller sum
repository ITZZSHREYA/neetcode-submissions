import java.util.Arrays;

class Solution {
    int countTriplets(int sum, int arr[]) 
    {
        int n=arr.length;
        Arrays.sort(arr);
        int ans=0;
        
        for(int i=0;i<n-2;i++)
        {
            int left=i+1;
            int right=n-1;
            while(left<right)
            {
                int sum2=arr[i]+arr[left]+arr[right];
                
                if(sum2<sum)
                {
                    ans+=(right-left);
                    left++;
                    
                }
                else
                {
                    right--;
                }
            }
        }
        return ans;
    }
}
